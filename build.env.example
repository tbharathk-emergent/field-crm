# ============================================================================
# FieldCRM per-tenant Capacitor build — SINGLE source of truth
# Copy to /app/build.env (or pass --env-file <path>) and fill in your values.
# The FastAPI server is NOT affected by this file.
# ============================================================================

# ---- 1. Backend + web URLs baked into the tenant app ----
# Backend API the tenant app will call at runtime.
API_BASE_URL=https://groceryapi.localappstore.in
# Root domain used by the subdomain resolver on cold-start.
PLATFORM_HOST=grocery.localappstore.in
# Canonical hosted web URL (used for Universal Links / deep-link seed).
WEB_BASE_URL=https://grocery.localappstore.in

# ---- 2. Super admin credentials (used to fetch tenant build manifest) ----
SUPER_ADMIN_PHONE=9858558555
SUPER_ADMIN_OTP=557725
# Optional: pre-obtained JWT — if set, script skips the OTP flow entirely.
# SUPER_ADMIN_TOKEN=

# ---- 3. Android release signing (required only for --output aab) ----
# For --output apk (debug), leave blank and Gradle uses the debug keystore.
ANDROID_KEYSTORE_PATH=/Users/wafutechnologies/Documents/Projects/grocery/coverage/follo.jks
ANDROID_KEYSTORE_PASSWORD=android
ANDROID_KEY_ALIAS=follo
ANDROID_KEY_PASSWORD=android

# ---- 4. iOS ----
# Apple Developer team ID (10 chars, e.g. YY28T8HJ3C).
IOS_TEAM_ID=YY28T8HJ3C
# Reverse-DNS bundle prefix; final bundle = ${IOS_BUNDLE_PREFIX}.<sanitized-slug>.
IOS_BUNDLE_PREFIX=in.localappstore.fieldcrm

# ---- 5. Build output + Android SDK ----
# Where per-tenant projects land — <OUTPUT_DIR>/<tenant-slug>/
OUTPUT_DIR=./output
# Optional; only required if you use --output apk|aab (actual gradle compile).
# ANDROID_HOME=/opt/android-sdk
